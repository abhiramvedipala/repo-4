# Copy to .env before `make dev`. Values below are dev-only defaults, not secrets.

# --- Postgres (docker-compose service: postgres) ---
POSTGRES_USER=spanscope
POSTGRES_PASSWORD=spanscope
POSTGRES_DB=spanscope
POSTGRES_PORT=5432
DATABASE_URL=postgresql://spanscope:spanscope@localhost:5432/spanscope

# --- Redis (docker-compose service: redis, wired up in Phase 7) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
